{
  "name": "parsiword-workspace",
  "private": true,
  "version": "0.4.7",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "pnpm --filter @parsiword/app run tauri",
    "test": "vitest run",
    "test:ui": "playwright test",
    "check:architecture": "node scripts/check-architecture.mjs",
    "android:apk": "pnpm run tauri android build --apk --target aarch64 --ci",
    "android:preview": "pnpm run tauri android build --debug --apk --target aarch64 --ci",
    "android:test-apk": "node scripts/build-android-preview.mjs",
    "desktop:build": "pnpm run tauri build --ci",
    "linux:build": "pnpm run tauri build --bundles deb,appimage --ci",
    "windows:build": "pnpm run tauri build --bundles nsis --ci",
    "ios:init": "pnpm run tauri ios init --ci",
    "ios:simulator": "pnpm run tauri ios build --target aarch64-sim --no-sign --ci",
    "ios:build": "pnpm run tauri ios build --ci",
    "macos:build": "pnpm run tauri build --bundles dmg --ci",
    "samples:build": "node scripts/build-default-document.mjs",
    "samples:check": "node scripts/build-default-document.mjs --check",
    "ui:capture": "node scripts/capture-ui.mjs",
    "build:vscode": "tsc --noEmit && node apps/vscode/scripts/build.mjs",
    "package:vscode": "pnpm run build:vscode && node apps/vscode/scripts/package.mjs",
    "test:vscode": "pnpm run build:vscode && node apps/vscode/scripts/test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2",
    "@types/katex": "^0.16.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@xmldom/xmldom": "^0.9.12",
    "docx": "^9.13.0",
    "fake-indexeddb": "^6.2.6",
    "highlight.js": "11.12.0",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^5.4.624",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.28.0"
  }
}
