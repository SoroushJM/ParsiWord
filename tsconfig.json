{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": [
        "./packages/core/src/*"
      ],
      "@parsiword/core/*": [
        "./packages/core/src/*"
      ]
    }
  },
  "include": [
    "packages/core/src",
    "apps/parsiword/src",
    "apps/vscode/webview"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
