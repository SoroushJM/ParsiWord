{
  "name": "parsiword-vscode",
  "displayName": "ParsiWord — RTL Markdown Editor",
  "description": "View and edit Persian, Arabic and mixed RTL/LTR Markdown, with editable preview, LaTeX, TikZ geometry, Mermaid and Word/PDF export.",
  "version": "0.1.11",
  "publisher": "SoroushJM",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "rtl",
    "persian",
    "arabic",
    "latex",
    "mermaid",
    "tikz",
    "geometry"
  ],
  "main": "./dist/extension.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/SoroushJM/ParsiWord"
  },
  "dependencies": {
    "@parsiword/core": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3"
  },
  "activationEvents": [
    "onCustomEditor:parsiword.markdown",
    "onCustomEditor:parsiword.markdown.source",
    "onCustomEditor:parsiword.markdown.rendered",
    "onLanguage:markdown",
    "onCustomEditor:parsiword.markdown.diff"
  ],
  "extensionDependencies": [
    "vscode.markdown-language-features"
  ],
  "contributes": {
    "configurationDefaults": {
      "workbench.diffEditorAssociations": {
        "*.{md,markdown,mdown,mkd,mkdn,mdwn,markdn,mdtxt,mdtext}": "parsiword.markdown"
      }
    },
    "customEditors": [
      {
        "viewType": "parsiword.markdown",
        "displayName": "ParsiWord Source + Result",
        "selector": [
          {
            "filenamePattern": "*.{md,markdown,mdown,mkd,mkdn,mdwn,markdn,mdtxt,mdtext}"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "parsiword.markdown.source",
        "displayName": "ParsiWord Markdown Source",
        "selector": [
          {
            "filenamePattern": "*.{md,markdown,mdown,mkd,mkdn,mdwn,markdn,mdtxt,mdtext}"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "parsiword.markdown.rendered",
        "displayName": "ParsiWord Rendered Result",
        "selector": [
          {
            "filenamePattern": "*.{md,markdown,mdown,mkd,mkdn,mdwn,markdn,mdtxt,mdtext}"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "parsiword.markdown.diff",
        "displayName": "ParsiWord Git Comparison",
        "selector": [
          {
            "filenamePattern": "*.{md,markdown,mdown,mkd,mkdn,mdwn,markdn,mdtxt,mdtext}"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "parsiword.nativeDiff",
        "title": "ParsiWord: Open Git Diff in VS Code (Working Tree)",
        "icon": "$(git-compare)"
      },
      {
        "command": "parsiword.nativeStagedDiff",
        "title": "ParsiWord: Open Git Diff in VS Code (Staged)",
        "icon": "$(git-compare)"
      },
      {
        "command": "parsiword.open",
        "title": "ParsiWord: Open in ParsiWord",
        "icon": "$(open-preview)"
      },
      {
        "command": "parsiword.source",
        "title": "ParsiWord: Open Native Source Beside",
        "icon": "$(code)"
      },
      {
        "command": "parsiword.nativePreview",
        "title": "ParsiWord: Open VS Code Markdown Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "parsiword.gitDiff",
        "title": "ParsiWord: Git Diff (Working Tree)",
        "icon": "$(git-compare)"
      },
      {
        "command": "parsiword.stagedDiff",
        "title": "ParsiWord: Git Diff (Staged)",
        "icon": "$(git-compare)"
      },
      {
        "command": "parsiword.find",
        "title": "ParsiWord: Find in Document"
      },
      {
        "command": "parsiword.replace",
        "title": "ParsiWord: Replace in Document"
      },
      {
        "command": "parsiword.goToLine",
        "title": "ParsiWord: Go to Markdown Line"
      },
      {
        "command": "parsiword.findNext",
        "title": "ParsiWord: Find Next"
      },
      {
        "command": "parsiword.findPrevious",
        "title": "ParsiWord: Find Previous"
      }
    ],
    "keybindings": [
      {
        "command": "parsiword.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "!inputFocus && !inQuickOpen && activeCustomEditorId =~ /^parsiword\\.markdown/"
      },
      {
        "command": "parsiword.replace",
        "key": "ctrl+h",
        "mac": "alt+cmd+f",
        "when": "!inputFocus && !inQuickOpen && activeCustomEditorId =~ /^parsiword\\.markdown/"
      },
      {
        "command": "parsiword.goToLine",
        "key": "ctrl+g",
        "mac": "ctrl+g",
        "when": "!inputFocus && !inQuickOpen && activeCustomEditorId =~ /^parsiword\\.markdown/"
      },
      {
        "command": "parsiword.findNext",
        "key": "f3",
        "when": "!inputFocus && !inQuickOpen && activeCustomEditorId =~ /^parsiword\\.markdown/"
      },
      {
        "command": "parsiword.findPrevious",
        "key": "shift+f3",
        "when": "!inputFocus && !inQuickOpen && activeCustomEditorId =~ /^parsiword\\.markdown/"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "parsiword.source",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "parsiword.open",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "parsiword.gitDiff",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "parsiword.stagedDiff",
          "when": "resourceLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "ParsiWord",
      "properties": {
        "parsiword.direction": {
          "type": "string",
          "enum": [
            "auto",
            "rtl",
            "ltr"
          ],
          "default": "auto",
          "description": "Default document direction."
        },
        "parsiword.language": {
          "type": "string",
          "enum": [
            "fa",
            "en"
          ],
          "default": "fa",
          "description": "Initial interface language."
        },
        "parsiword.fontFamily": {
          "type": "string",
          "default": "Vazirmatn",
          "description": "Default document/export font."
        },
        "parsiword.fontSize": {
          "type": "number",
          "enum": [
            10,
            11,
            12,
            14,
            16,
            18
          ],
          "default": 12,
          "description": "Export font size in points."
        },
        "parsiword.appearance": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "scope": "machine",
          "description": "Device appearance managed by the ParsiWord Theme panel. Shared by all ParsiWord editors and windows on this machine."
        }
      }
    }
  },
  "type": "module",
  "icon": "dist/webview/icon.png"
}
