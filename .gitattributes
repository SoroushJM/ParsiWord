# The generated Markdown preserves hard line breaks and upstream code whitespace.
# Keep generated samples stable across Windows and Unix checkouts.
packages/core/src/default-document.md text eol=lf whitespace=-blank-at-eol
packages/core/src/starter-document.md text eol=lf
# Vendored runtime hashes and upstream license bytes must survive Windows checkouts.
packages/core/public/tikz/** -text whitespace=-blank-at-eol,-blank-at-eof
third-party/tikz/sources/*.zip -text
